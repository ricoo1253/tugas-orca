#include <iostream>
#include <string>
using namespace std;

// CLASS MISSION MANAGER

class MissionManager {
public:

    string missionState;


    MissionManager() {
        missionState = "IDLE";
    }


    // Fungsi untuk memperbarui kondisi misi
    void updateMission(string objectName, double confidence, double distance) {

        // Tidak ada objek
        if (objectName == "None") {

            missionState = "SEARCHING";

        }

        // Objek ditemukan dan confidence memenuhi syarat
        else if (confidence >= 0.70) {

            // Sudah sangat dekat
            if (distance <= 0.5) {

                missionState = "MISSION_COMPLETE";

            }

            // Jarak <= 2 meter
            else if (distance <= 2.0) {

                missionState = "APPROACHING";

            }

           

                missionState = "DETECTED";

            }
        }

        // Objek ada tetapi confidence terlalu rendah
        else {

            missionState = "SEARCHING";

        }
    }


    // Fungsi untuk menampilkan informasi misi
    void showMission(string objectName, double confidence, double distance) {

        cout << "Object detected : " << objectName << endl;
        cout << "Confidence      : " << confidence << endl;
        cout << "Distance        : " << distance << " m" << endl;
        cout << "Mission State   : " << missionState << endl;


        // Menentukan aksi ORCA
        if (missionState == "SEARCHING") {

            cout << "Action          : SEARCH FOR TARGET" << endl;

        }

        else if (missionState == "DETECTED") {

            cout << "Action          : APPROACH TARGET" << endl;

        }

        else if (missionState == "APPROACHING") {

            cout << "Action          : CONTINUE APPROACHING" << endl;

        }

        else if (missionState == "MISSION_COMPLETE") {

            cout << "Action          : MISSION COMPLETE" << endl;

        }
    }
};

// MAIN PROGRAM

int main() {

    string objectName;
    double confidence;
    double distance;


    // Input dari sistem vision
    cout << "INPUT Object : ";
    cin >> objectName;

    cout << "Confidence: ";
    cin >> confidence;

    cout << "Distance : ";
    cin >> distance;


    // Membuat object MissionManager
    MissionManager mission;


    // Memperbarui kondisi misi
    mission.updateMission(objectName, confidence, distance);


    // Menampilkan hasil
    cout << endl;
    mission.showMission(objectName, confidence, distance);


    return 0;
}